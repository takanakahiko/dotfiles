{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "dotfiles-deps",
  "owner": {
    "name": "takanakahiko"
  },
  "description": "他の人が作ったプラグインへの参照（中身は持たず、コミットで固定する）",
  "plugins": [
    {
      "name": "japanese-guard",
      "description": "英語で返答したら日本語で書き直させるフック（minorun365/claude-code-japanese-guard）",
      "source": {
        "source": "github",
        "repo": "minorun365/claude-code-japanese-guard",
        "sha": "2b4965f31b8859ec71dea06395a0aecf15e68da1"
      },
      "hooks": {
        "Stop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "/usr/bin/python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/japanese-guard.py\""
              }
            ]
          }
        ],
        "PreToolUse": [
          {
            "matcher": "mcp__.*__wrap_up",
            "hooks": [
              {
                "type": "command",
                "command": "/usr/bin/python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/japanese-guard.py\""
              }
            ]
          }
        ]
      }
    }
  ]
}
