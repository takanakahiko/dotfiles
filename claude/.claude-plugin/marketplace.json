{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "dotfiles-deps",
  "owner": { "name": "takanakahiko" },
  "description": "他の人が作ったプラグインへの参照（中身は持たず、コミットで固定する）",
  "plugins": [
    {
      "name": "yomiyasu",
      "description": "AI が生成した日本語を推敲するスキル（nanaism/yomiyasu）",
      "source": {
        "source": "github",
        "repo": "nanaism/yomiyasu",
        "sha": "c49d5f1bee91258e33e1febc3569c6c87be7669e"
      }
    },
    {
      "name": "japanese-guard",
      "description": "英語で返答したら日本語で書き直させるフック（minorun365/claude-code-japanese-guard）",
      "source": {
        "source": "github",
        "repo": "minorun365/claude-code-japanese-guard",
        "sha": "2b4965f31b8859ec71dea06395a0aecf15e68da1"
      },
      "hooks": {
        "Stop": [
          { "hooks": [ { "type": "command", "command": "/usr/bin/python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/japanese-guard.py\"" } ] }
        ],
        "PreToolUse": [
          { "matcher": "mcp__.*__wrap_up", "hooks": [ { "type": "command", "command": "/usr/bin/python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/japanese-guard.py\"" } ] }
        ]
      }
    }
  ]
}
